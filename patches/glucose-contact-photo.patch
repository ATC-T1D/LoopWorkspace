diff --git a/Loop/Loop/Managers/GlucoseContact.swift b/Loop/Loop/Managers/GlucoseContact.swift
new file mode 100644
index 0000000..4358f60
--- /dev/null
+++ b/Loop/Loop/Managers/GlucoseContact.swift
@@ -0,0 +1,209 @@
+import Combine
+import Contacts
+import LoopKit
+import SwiftUI
+import UIKit
+
+/// Updates a dedicated contact so the system Contacts widget and watch complication can show Loop readings.
+@MainActor
+final class GlucoseContact: ObservableObject {
+    private enum Key {
+        static let enabled = "GlucoseContact.enabled"
+        static let trend = "GlucoseContact.trend"
+        static let contrast = "GlucoseContact.contrast"
+        static let identifier = "GlucoseContact.identifier"
+        static let needsOffImage = "GlucoseContact.needsOffImage"
+    }
+
+    @Published private(set) var enabled = UserDefaults.standard.bool(forKey: Key.enabled)
+    @Published private(set) var requestingAccess = false
+    @Published private(set) var message: String?
+    @Published var trend = UserDefaults.standard.object(forKey: Key.trend) as? Bool ?? true {
+        didSet { UserDefaults.standard.set(trend, forKey: Key.trend); refresh() }
+    }
+    @Published var contrast = UserDefaults.standard.bool(forKey: Key.contrast) {
+        didSet { UserDefaults.standard.set(contrast, forKey: Key.contrast); refresh() }
+    }
+
+    weak var deviceManager: DeviceDataManager?
+    private var expiration: Task<Void, Never>?
+    private let writes = DispatchQueue(label: "com.loopkit.glucoseContact")
+    private var revision = 0
+
+    func setEnabled(_ value: Bool) {
+        guard !requestingAccess else { return }
+        if value && CNContactStore.authorizationStatus(for: .contacts) == .notDetermined {
+            requestingAccess = true
+            Task {
+                do {
+                    let granted = try await CNContactStore().requestAccess(for: .contacts)
+                    requestingAccess = false
+                    if granted { setEnabled(true) } else { message = Self.permissionMessage }
+                } catch {
+                    requestingAccess = false
+                    message = error.localizedDescription
+                }
+            }
+            return
+        }
+        guard !value || Self.hasAccess else {
+            message = Self.permissionMessage
+            return
+        }
+        enabled = value
+        UserDefaults.standard.set(value, forKey: Key.enabled)
+        UserDefaults.standard.set(!value, forKey: Key.needsOffImage)
+        refresh()
+    }
+
+    private static var permissionMessage: String {
+        NSLocalizedString("Allow Loop to access Contacts in iOS Settings to update the contact photo.", comment: "Contacts permission help")
+    }
+
+    private static var hasAccess: Bool {
+        let status = CNContactStore.authorizationStatus(for: .contacts)
+        if #available(iOS 18, *), status == .limited { return true }
+        return status == .authorized
+    }
+
+    func refresh() {
+        expiration?.cancel()
+        revision += 1
+        guard enabled || UserDefaults.standard.bool(forKey: Key.needsOffImage), let deviceManager else { return }
+        guard Self.hasAccess else {
+            message = Self.permissionMessage
+            return
+        }
+
+        let sample = enabled ? deviceManager.glucoseStore.latestGlucose : nil
+        let deadline = sample?.startDate.addingTimeInterval(7 * 60)
+        let now = Date()
+        let fresh = sample.map { $0.startDate <= now } == true && deadline.map { now < $0 } == true
+        if fresh, let deadline {
+            expiration = Task { [weak self] in
+                try? await Task.sleep(for: .seconds(deadline.timeIntervalSince(now)))
+                guard !Task.isCancelled else { return }
+                self?.refresh()
+            }
+        }
+        let value = sample.map { reading -> String in
+            switch reading.condition {
+            case .belowRange: return "LOW"
+            case .aboveRange: return "HIGH"
+            case nil: return deviceManager.displayGlucosePreference.format(reading.quantity, includeUnit: false)
+            }
+        } ?? (enabled ? "—" : "OFF")
+        let range = deviceManager.glucoseDisplay(for: sample)?.glucoseRangeCategory
+        let color: Color
+        if !fresh { color = .gray }
+        else if contrast { color = .white }
+        else {
+            switch range {
+            case .belowRange, .urgentLow, .aboveRange: color = .red
+            case .low, .high: color = .yellow
+            case .normal: color = .green
+            case nil: color = .white
+            }
+        }
+        let arrow = fresh && trend ? (sample as? StoredGlucoseSample)?.trend?.symbol : nil
+        let timestamp = sample?.startDate.formatted(date: .omitted, time: .shortened)
+        let renderer = ImageRenderer(content: GlucoseContactPhoto(value: value, arrow: arrow, timestamp: timestamp, color: color))
+        guard let data = renderer.uiImage?.pngData() else { return }
+        let source = deviceManager.cgmManager?.localizedTitle ?? "Loop"
+        let detail = timestamp.map { "\(source) · \($0)" } ?? ""
+        let active = enabled
+        let currentRevision = revision
+        writes.async {
+            do {
+                try Self.save(data, detail: detail, active: active)
+                Task { @MainActor in
+                    guard currentRevision == self.revision else { return }
+                    self.message = nil
+                    if !active { UserDefaults.standard.removeObject(forKey: Key.needsOffImage) }
+                }
+            } catch {
+                Task { @MainActor in
+                    guard currentRevision == self.revision else { return }
+                    self.message = error.localizedDescription
+                }
+            }
+        }
+    }
+
+    nonisolated private static func save(_ image: Data, detail: String, active: Bool) throws {
+        let store = CNContactStore()
+        let request = CNSaveRequest()
+        let contact: CNMutableContact
+        if let id = UserDefaults.standard.string(forKey: Key.identifier) {
+            // A partial name match could point at someone else's address book entry.
+            // Recreate a deleted contact only when full access confirms it is missing.
+            let matches = try store.unifiedContacts(matching: CNContact.predicateForContacts(withIdentifiers: [id]),
+                                                    keysToFetch: [CNContactImageDataKey, CNContactOrganizationNameKey] as [CNKeyDescriptor])
+            if let existing = matches.first {
+                guard existing.imageData != image || existing.organizationName != detail else { return }
+                guard let editable = existing.mutableCopy() as? CNMutableContact else { return }
+                contact = editable
+                request.update(contact)
+            } else {
+                guard active else { return }
+                guard CNContactStore.authorizationStatus(for: .contacts) == .authorized else {
+                    throw NSError(domain: CNErrorDomain, code: CNError.Code.authorizationDenied.rawValue)
+                }
+                contact = CNMutableContact()
+                contact.givenName = "Loop"
+                request.add(contact, toContainerWithIdentifier: nil)
+            }
+        } else {
+            guard active else { return }
+            contact = CNMutableContact()
+            contact.givenName = "Loop"
+            request.add(contact, toContainerWithIdentifier: nil)
+        }
+        contact.organizationName = detail
+        contact.imageData = image
+        try store.execute(request)
+        UserDefaults.standard.set(contact.identifier, forKey: Key.identifier)
+    }
+}
+
+private struct GlucoseContactPhoto: View {
+    let value: String
+    let arrow: String?
+    let timestamp: String?
+    let color: Color
+
+    var body: some View {
+        ZStack {
+            Color.black
+            VStack(spacing: 0) {
+                Text(value).font(.system(size: arrow == nil ? 104 : 86, weight: .bold))
+                if let arrow { Text(arrow).font(.system(size: 54, weight: .bold)) }
+                if let timestamp {
+                    Text(timestamp).font(.system(size: 34, weight: .semibold)).monospacedDigit()
+                        .frame(maxWidth: 160)
+                }
+            }
+            .foregroundStyle(color)
+            .lineLimit(1)
+            .minimumScaleFactor(0.55)
+            .frame(width: 212)
+        }
+        .frame(width: 256, height: 256)
+    }
+}
+
+struct GlucoseContactSettings: View {
+    @ObservedObject var contact: GlucoseContact
+
+    var body: some View {
+        Section(header: Text("Glucose Contact Photo"), footer: Text("Loop creates a contact named Loop. Choose it in a Contacts widget or watch complication. The time on the photo is the reading time. Contacts can sync through your address book account.")) {
+            Toggle("Update Contact Photo", isOn: Binding(get: { contact.enabled }, set: contact.setEnabled))
+                .disabled(contact.requestingAccess)
+            if contact.enabled {
+                Toggle("Show Trend Arrow", isOn: $contact.trend)
+                Toggle("High Contrast", isOn: $contact.contrast)
+            }
+            if let message = contact.message { Text(message).font(.footnote) }
+        }
+    }
+}
