diff --git a/Loop/Loop/Views/ContactGlucoseImageSettingsView.swift b/Loop/Loop/Views/ContactGlucoseImageSettingsView.swift
new file mode 100644
index 0000000..5e9da38
--- /dev/null
+++ b/Loop/Loop/Views/ContactGlucoseImageSettingsView.swift
@@ -0,0 +1,86 @@
+import Contacts
+import ContactsUI
+import SwiftUI
+
+struct ContactGlucoseImageSettingsView: View {
+    @ObservedObject private var manager = ContactGlucoseImageManager.shared
+    @State private var showingPicker = false
+    @State private var requestingAccess = false
+    @State private var accessError: String?
+
+    var body: some View {
+        Form {
+            Section(footer: Text("This replaces the selected contact’s photo. Use a dedicated contact. The photo may sync to your other devices and contact services.")) {
+                Button(manager.contactName.isEmpty ? "Choose Contact" : "Contact: \(manager.contactName)") {
+                    chooseContact()
+                }
+                .disabled(requestingAccess)
+                Toggle("Update Contact Photo", isOn: Binding(
+                    get: { manager.enabled },
+                    set: { manager.setEnabled($0) }
+                ))
+                .disabled(manager.contactName.isEmpty)
+            }
+            Section(header: Text("Status"), footer: Text("Shows glucose, trend, units, and a large reading time. The date helps identify old readings. Updates depend on Loop receiving glucose and iOS allowing contact writes; the photo can be stale. Turning this off leaves the last photo in place.")) {
+                Text(manager.status)
+                if let accessError { Text(accessError).foregroundColor(.red) }
+            }
+        }
+        .navigationTitle("Contact Image")
+        .sheet(isPresented: $showingPicker) {
+            ContactGlucosePicker { contact in
+                if let contact {
+                    let name = CNContactFormatter.string(from: contact, style: .fullName) ?? "Selected Contact"
+                    manager.selectContact(identifier: contact.identifier, name: name)
+                }
+                showingPicker = false
+            }
+        }
+    }
+
+    private func chooseContact() {
+        // Changing contacts requires explicitly enabling updates again.
+        manager.setEnabled(false)
+        accessError = nil
+        if ContactGlucoseImageManager.hasContactsAccess {
+            showingPicker = true
+        } else if CNContactStore.authorizationStatus(for: .contacts) == .notDetermined {
+            requestingAccess = true
+            CNContactStore().requestAccess(for: .contacts) { _, _ in
+                DispatchQueue.main.async {
+                    requestingAccess = false
+                    if ContactGlucoseImageManager.hasContactsAccess {
+                        showingPicker = true
+                    } else {
+                        accessError = "Allow Contacts access in iOS Settings to use this feature."
+                    }
+                }
+            }
+        } else {
+            accessError = "Allow Contacts access in iOS Settings to use this feature."
+        }
+    }
+}
+
+private struct ContactGlucosePicker: UIViewControllerRepresentable {
+    let onSelection: (CNContact?) -> Void
+
+    func makeCoordinator() -> Coordinator { Coordinator(onSelection: onSelection) }
+
+    func makeUIViewController(context: Context) -> CNContactPickerViewController {
+        let picker = CNContactPickerViewController()
+        picker.delegate = context.coordinator
+        return picker
+    }
+
+    func updateUIViewController(_ controller: CNContactPickerViewController, context: Context) {}
+
+    final class Coordinator: NSObject, CNContactPickerDelegate {
+        let onSelection: (CNContact?) -> Void
+        init(onSelection: @escaping (CNContact?) -> Void) { self.onSelection = onSelection }
+        func contactPicker(_ picker: CNContactPickerViewController, didSelect contact: CNContact) {
+            onSelection(contact)
+        }
+        func contactPickerDidCancel(_ picker: CNContactPickerViewController) { onSelection(nil) }
+    }
+}
