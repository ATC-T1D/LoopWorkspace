diff --git a/Loop/Loop/Managers/ContactGlucoseImageManager.swift b/Loop/Loop/Managers/ContactGlucoseImageManager.swift
new file mode 100644
index 0000000..1d61f51
--- /dev/null
+++ b/Loop/Loop/Managers/ContactGlucoseImageManager.swift
@@ -0,0 +1,177 @@
+import Combine
+import Contacts
+import LoopKit
+import LoopAlgorithm
+import LoopKitUI
+import UIKit
+
+/// A display-only integration. Contact I/O never runs on the dosing/main actor.
+@MainActor
+final class ContactGlucoseImageManager: ObservableObject {
+    static let shared = ContactGlucoseImageManager()
+    private enum Key {
+        static let enabled = "ContactGlucoseImage.enabled"
+        static let identifier = "ContactGlucoseImage.identifier"
+        static let name = "ContactGlucoseImage.name"
+    }
+
+    @Published private(set) var enabled: Bool
+    @Published private(set) var contactName: String
+    @Published private(set) var status = "Waiting for a glucose reading."
+    private var identifier: String
+    private var latest: ContactGlucoseImageContent?
+    private let queue = DispatchQueue(label: "com.Loop.contact-glucose-image", qos: .utility)
+    private let writer = ContactGlucoseImageWriter()
+    private var generation = 0
+
+    private init() {
+        let defaults = UserDefaults.standard
+        identifier = defaults.string(forKey: Key.identifier) ?? ""
+        contactName = defaults.string(forKey: Key.name) ?? ""
+        enabled = defaults.bool(forKey: Key.enabled) && !identifier.isEmpty
+        configureWriter()
+        if !enabled { status = "Updates off. Existing photo is unchanged." }
+    }
+
+    static var hasContactsAccess: Bool {
+        let authorization = CNContactStore.authorizationStatus(for: .contacts)
+        if #available(iOS 18.0, *), authorization == .limited { return true }
+        return authorization == .authorized
+    }
+
+    func selectContact(identifier: String, name: String) {
+        setEnabled(false)
+        self.identifier = identifier
+        contactName = name
+        UserDefaults.standard.set(identifier, forKey: Key.identifier)
+        UserDefaults.standard.set(name, forKey: Key.name)
+        configureWriter()
+        status = "Contact selected. Enable to replace its photo."
+    }
+
+    func setEnabled(_ value: Bool) {
+        enabled = value && !identifier.isEmpty && Self.hasContactsAccess
+        UserDefaults.standard.set(enabled, forKey: Key.enabled)
+        configureWriter()
+        status = enabled ? "Waiting for a glucose reading." : "Updates off. Existing photo is unchanged."
+        if value && !Self.hasContactsAccess {
+            status = "Allow Contacts access in iOS Settings, then try again."
+        }
+        if enabled, let latest { submit(latest) }
+    }
+
+    private func configureWriter() {
+        generation += 1
+        let identifier = self.identifier
+        let enabled = self.enabled
+        queue.async { [writer] in writer.configure(identifier: identifier, enabled: enabled) }
+    }
+
+    func update(sample: GlucoseSampleValue, preference: DisplayGlucosePreference) {
+        // Never replace a newer reading with backfill or a future-dated sample.
+        guard sample.startDate <= Date(),
+              sample.startDate >= (latest?.date ?? .distantPast) else { return }
+        let glucose: String
+        switch sample.condition {
+        case .belowRange?: glucose = "LOW"
+        case .aboveRange?: glucose = "HIGH"
+        case nil: glucose = preference.format(sample.quantity, includeUnit: false)
+        }
+        let content = ContactGlucoseImageContent(
+            glucose: glucose,
+            trend: (sample as? StoredGlucoseSample)?.trend?.symbol ?? "–",
+            unit: preference.unit.shortLocalizedUnitString(),
+            date: sample.startDate
+        )
+        latest = content
+        if enabled { submit(content) }
+    }
+
+    private func submit(_ content: ContactGlucoseImageContent) {
+        let generation = self.generation
+        queue.async { [writer, weak self] in
+            let result = writer.write(content)
+            DispatchQueue.main.async { [weak self] in
+                guard let self, self.generation == generation else { return }
+                if let result { self.status = result }
+            }
+        }
+    }
+}
+
+struct ContactGlucoseImageContent: Equatable {
+    let glucose: String
+    let trend: String
+    let unit: String
+    let date: Date
+
+    func pngData() -> Data? {
+        let format = UIGraphicsImageRendererFormat()
+        format.scale = 1
+        format.opaque = true
+        let renderer = UIGraphicsImageRenderer(size: CGSize(width: 512, height: 512), format: format)
+        return renderer.image { context in
+            UIColor.black.setFill()
+            context.fill(CGRect(x: 0, y: 0, width: 512, height: 512))
+            func draw(_ text: String, y: CGFloat, size: CGFloat, width: CGFloat = 400) {
+                var fontSize = size
+                while fontSize > 20 && (text as NSString).size(withAttributes: [
+                    .font: UIFont.boldSystemFont(ofSize: fontSize)
+                ]).width > width { fontSize -= 1 }
+                let paragraph = NSMutableParagraphStyle()
+                paragraph.alignment = .center
+                (text as NSString).draw(in: CGRect(x: (512 - width) / 2, y: y, width: width, height: fontSize * 1.5), withAttributes: [
+                    .font: UIFont.boldSystemFont(ofSize: fontSize),
+                    .foregroundColor: UIColor.white,
+                    .paragraphStyle: paragraph
+                ])
+            }
+            draw("\(glucose) \(trend)", y: 135, size: 112)
+            draw(unit, y: 252, size: 28)
+            let time = DateFormatter()
+            time.timeStyle = .short
+            // Use the sample timestamp, not Date(), so an old reading is never relabeled fresh.
+            draw(time.string(from: date), y: 300, size: 64, width: 370)
+            let day = DateFormatter()
+            day.setLocalizedDateFormatFromTemplate("MMM d")
+            draw(day.string(from: date), y: 378, size: 30, width: 280)
+        }.pngData()
+    }
+}
+
+/// All methods/state are confined to the manager's serial utility queue.
+private final class ContactGlucoseImageWriter {
+    private let store = CNContactStore()
+    private var identifier = ""
+    private var enabled = false
+    private var lastWritten: ContactGlucoseImageContent?
+
+    func configure(identifier: String, enabled: Bool) {
+        if self.identifier != identifier || self.enabled != enabled { lastWritten = nil }
+        self.identifier = identifier
+        self.enabled = enabled
+    }
+
+    func write(_ content: ContactGlucoseImageContent) -> String? {
+        guard enabled, !identifier.isEmpty, content != lastWritten else { return nil }
+        do {
+            // Fetch afresh: preserve all other contact fields and never create duplicates.
+            let contact = try store.unifiedContact(withIdentifier: identifier, keysToFetch: [
+                CNContactIdentifierKey as CNKeyDescriptor,
+                CNContactImageDataKey as CNKeyDescriptor
+            ])
+            guard let mutable = contact.mutableCopy() as? CNMutableContact,
+                  let data = content.pngData() else {
+                return "Unable to create contact photo."
+            }
+            mutable.imageData = data
+            let request = CNSaveRequest()
+            request.update(mutable)
+            try store.execute(request)
+            lastWritten = content // Failed writes remain retryable on the next reading.
+            return "Photo updated. Timestamp shows when glucose was measured."
+        } catch {
+            return "Photo update failed. Check Contacts access and that the selected contact is editable."
+        }
+    }
+}
