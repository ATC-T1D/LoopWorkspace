diff --git a/Loop/Loop/Managers/GlucoseIconBadge.swift b/Loop/Loop/Managers/GlucoseIconBadge.swift
new file mode 100644
index 0000000..53f4a5a
--- /dev/null
+++ b/Loop/Loop/Managers/GlucoseIconBadge.swift
@@ -0,0 +1,113 @@
+import LoopKit
+import LoopCore
+import SwiftUI
+import UserNotifications
+
+@MainActor
+final class GlucoseIconBadge: ObservableObject {
+    nonisolated static let expirationIdentifier = "Loop.GlucoseIconBadge.expiration"
+    private static let enabledKey = "GlucoseIconBadge.enabled"
+    private static let cleanupKey = "GlucoseIconBadge.needsCleanup"
+
+    @Published private(set) var enabled = UserDefaults.standard.bool(forKey: enabledKey)
+    @Published private(set) var message: String?
+    weak var deviceManager: DeviceDataManager?
+    private let center = UNUserNotificationCenter.current()
+    private var updating = false
+    private var pending = false
+
+    func setEnabled(_ value: Bool) {
+        enabled = value
+        UserDefaults.standard.set(value, forKey: Self.enabledKey)
+        UserDefaults.standard.set(true, forKey: Self.cleanupKey)
+        refresh()
+    }
+
+    // Serialize notification-center writes. If another reading arrives during an
+    // await, process the latest state again after the current update finishes.
+    func refresh() {
+        guard enabled || UserDefaults.standard.bool(forKey: Self.cleanupKey) else { return }
+        pending = true
+        guard !updating else { return }
+        updating = true
+        Task {
+            while pending {
+                pending = false
+                do {
+                    try await update()
+                } catch {
+                    message = error.localizedDescription
+                }
+            }
+            updating = false
+        }
+    }
+
+    private func update() async throws {
+        if !enabled {
+            center.removePendingNotificationRequests(withIdentifiers: [Self.expirationIdentifier])
+            try await center.setBadgeCount(0)
+            if !enabled { UserDefaults.standard.removeObject(forKey: Self.cleanupKey) }
+            message = nil
+            return
+        }
+
+        var settings = await center.notificationSettings()
+        if settings.authorizationStatus == .notDetermined {
+            // Use Loop's existing notification options, including critical alerts when enabled.
+            await withCheckedContinuation { continuation in
+                NotificationManager.authorize { _ in continuation.resume() }
+            }
+            settings = await center.notificationSettings()
+        }
+        guard enabled else { return }
+        guard settings.badgeSetting == .enabled else {
+            center.removePendingNotificationRequests(withIdentifiers: [Self.expirationIdentifier])
+            message = NSLocalizedString("Turn on Badges for Loop in iOS Notification settings.", comment: "Glucose icon badge permission")
+            return
+        }
+        message = nil
+        guard let manager = deviceManager,
+              let reading = manager.glucoseStore.latestGlucose,
+              reading.condition == nil, !reading.isDisplayOnly,
+              reading.startDate <= Date() else {
+            try await clear()
+            return
+        }
+        let remaining = reading.startDate.addingTimeInterval(7 * 60).timeIntervalSinceNow
+        let unit = manager.displayGlucosePreference.unit
+        let value = reading.quantity.doubleValue(for: unit)
+        let count = (unit == .millimolesPerLiter ? value * 10 : value).rounded()
+        guard remaining >= 1, let badge = Int(exactly: count), badge > 0 else {
+            try await clear()
+            return
+        }
+
+        // The system can clear a stale reading even when Loop is suspended.
+        let content = UNMutableNotificationContent()
+        content.badge = 0
+        let trigger = UNTimeIntervalNotificationTrigger(timeInterval: remaining, repeats: false)
+        try await center.add(UNNotificationRequest(identifier: Self.expirationIdentifier, content: content, trigger: trigger))
+        guard enabled, !pending, reading.startDate.addingTimeInterval(7 * 60) > Date() else {
+            if !pending { try await clear() }
+            return
+        }
+        try await center.setBadgeCount(badge)
+    }
+
+    private func clear() async throws {
+        center.removePendingNotificationRequests(withIdentifiers: [Self.expirationIdentifier])
+        try await center.setBadgeCount(0)
+    }
+}
+
+struct GlucoseIconBadgeSettings: View {
+    @ObservedObject var badge: GlucoseIconBadge
+
+    var body: some View {
+        Section(footer: Text("Shows the latest glucose on the Loop app icon for seven minutes. The badge uses whole numbers: 105 mg/dL appears as 105, and 5.8 mmol/L appears as 58.")) {
+            Toggle("Glucose on App Icon", isOn: Binding(get: { badge.enabled }, set: badge.setEnabled))
+            if let message = badge.message { Text(message).font(.footnote) }
+        }
+    }
+}
